# ── Supabase (client-side — ANON KEY ONLY, never the service role) ────────────
# The service role key bypasses RLS and must NEVER appear in client bundles.
VITE_SUPABASE_URL=https://ntxtlhbqoqcfvbpbjacc.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Public key is safe for clients (VITE_). Private key is SERVER-SIDE ONLY and
# lives in Supabase Edge Function secrets, never in this file.
# Generate a pair with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# ── Server-side secrets (NEVER commit, NEVER in client code) ──────────────────
# SUPABASE_SERVICE_ROLE_KEY=   → Supabase Edge Function secrets only
# VAPID_PRIVATE_KEY=           → Supabase Edge Function secrets only
